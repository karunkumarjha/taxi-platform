# Local-dev Airflow connections + variables. Imported by `astro dev start`
# into a fresh metadata DB.
#
# This file is a TEMPLATE — `scripts/bootstrap.sh` substitutes the
# __PLACEHOLDER__ tokens with values pulled from `terraform output` and
# writes the result to airflow_settings.yaml (gitignored). Don't edit
# this file by hand unless you're adjusting the structure.

airflow:
  connections:
    # ---- Snowflake (per-role connections, matches RBAC) ------------------
    # LOADER — used ONLY by load_one_month_to_snowflake. Writes RAW.YELLOW_TRIPDATA.
    - conn_id: snowflake_loader
      conn_type: snowflake
      conn_login: LOADER
      conn_password: __SNOWFLAKE_LOADER_PASSWORD__
      conn_schema: RAW
      conn_extra:
        account: __SNOWFLAKE_ACCOUNT__
        warehouse: WH_XS
        database: ANALYTICS
        role: LOADER
        raw_schema: RAW
        stage: S3_TLC_STAGE
        file_format: PARQUET_FF
        raw_table: YELLOW_TRIPDATA

    # DBT — used by every dbt task + the swap. Owns MARTS + MARTS_BUILD.
    - conn_id: snowflake_dbt
      conn_type: snowflake
      conn_login: DBT
      conn_password: __SNOWFLAKE_DBT_PASSWORD__
      conn_schema: MARTS_BUILD
      conn_extra:
        account: __SNOWFLAKE_ACCOUNT__
        warehouse: WH_XS
        database: ANALYTICS
        role: DBT

    # ---- AWS — uses host's default credential chain (~/.aws/credentials) ---
    - conn_id: aws_default
      conn_type: aws
      conn_extra:
        region_name: __AWS_REGION__

  variables:
    - variable_name: s3_bucket
      variable_value: __S3_BUCKET__
    - variable_name: s3_raw_prefix
      variable_value: raw/
    - variable_name: aws_region
      variable_value: __AWS_REGION__
    # ---- EMR Serverless (used by the spark_historical DAG) ----
    - variable_name: emr_application_id
      variable_value: __EMR_APPLICATION_ID__
    - variable_name: emr_exec_role_arn
      variable_value: __EMR_EXEC_ROLE_ARN__
    # ---- Iceberg + Glue (used by the spark_historical DAG) ----
    - variable_name: glue_database
      variable_value: __GLUE_DATABASE_NAME__
    - variable_name: snowflake_external_volume
      variable_value: __SNOWFLAKE_EXTERNAL_VOLUME__
    - variable_name: snowflake_catalog_integration
      variable_value: __SNOWFLAKE_CATALOG_INTEGRATION__

  pools: []
