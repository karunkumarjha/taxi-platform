# Local-dev environment variables for the Airflow containers.
# This file is a TEMPLATE — `scripts/bootstrap.sh` substitutes the
# __PLACEHOLDER__ token with the value from the repo-root .env and
# writes the result to airflow/.env (gitignored).
#
# Astro CLI (`astro dev start`) auto-loads `airflow/.env` into the
# Airflow scheduler/worker/webserver containers.

# ---- Gmail SMTP for failure alerts -----------------------------------------
# Bootstrap substitutes ALERT_EMAIL and GMAIL_APP_PASSWORD from repo-root .env
# into the placeholders below. The DAGs' DEFAULT_ARGS["email"] also reads
# ALERT_EMAIL at parse time, so alerts reach the same address.

AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=__ALERT_EMAIL__
AIRFLOW__SMTP__SMTP_PASSWORD=__GMAIL_APP_PASSWORD__
AIRFLOW__SMTP__SMTP_MAIL_FROM=__ALERT_EMAIL__

# Read by DAG DEFAULT_ARGS["email"] at parse time. If empty, alerting is
# silently disabled (no error, no email).
ALERT_EMAIL=__ALERT_EMAIL__
