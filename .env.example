# =============================================================================
# Local environment for the analytics project. Copy to .env and fill in.
# .env is gitignored — never commit it.
#
# The file has THREE sections:
#   [STEP 1]   Fill in BEFORE running `terraform apply`.
#   [STEP 2]   Fill in AFTER running `terraform apply`.
#              (Generated by Terraform — read with `terraform output -raw <name>`.)
#   [STEP 3]   Already-correct defaults. Don't change unless you have a reason.
# =============================================================================


# =============================================================================
# [STEP 1]  PRE-APPLY  — set these before `make infra-apply`.
# =============================================================================

# --- Snowflake account locator -----------------------------------------------
# Snowsight → bottom-left → click your account name → copy the ORG-ACCOUNT
# locator (something like ABCD-XY12345). Required by every Snowflake call.
SNOWFLAKE_ACCOUNT=ABCD-XY12345

# --- Snowflake admin (used ONLY by Terraform) --------------------------------
# Manually create this user in Snowsight FIRST (see README "Snowflake setup"):
#     CREATE USER TF_USER PASSWORD = '<strong>' DEFAULT_ROLE = ACCOUNTADMIN
#       DEFAULT_WAREHOUSE = COMPUTE_WH MUST_CHANGE_PASSWORD = FALSE;
#     GRANT ROLE ACCOUNTADMIN TO USER TF_USER;
SNOWFLAKE_TF_USER=TF_USER
SNOWFLAKE_TF_PASSWORD=change-me

# --- AWS region for Terraform + boto3 ----------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=default

# --- Gmail SMTP for Airflow failure alerts -----------------------------------
# Both fields used by bootstrap to render airflow/.env so Airflow can send
# failure emails. The DAG DEFAULT_ARGS["email"] also reads ALERT_EMAIL at
# parse time so alerts go to the same address.
#   ALERT_EMAIL          — Gmail address (sender + recipient)
#   GMAIL_APP_PASSWORD   — 16-char app password (no spaces) from
#                          https://myaccount.google.com/apppasswords
ALERT_EMAIL=you@example.com
GMAIL_APP_PASSWORD=change-me


# =============================================================================
# [STEP 2]  POST-APPLY  — populate from `terraform output` after `terraform apply`.
# =============================================================================

# --- S3 bucket Terraform created ---------------------------------------------
#     terraform -chdir=infra output -raw s3_bucket
S3_BUCKET=

# --- Snowflake user passwords Terraform generated -----------------------------
#     terraform -chdir=infra output -raw snowflake_loader_password
#     terraform -chdir=infra output -raw snowflake_dbt_password
#     terraform -chdir=infra output -raw snowflake_analyst_password
SNOWFLAKE_LOADER_PASSWORD=
SNOWFLAKE_DBT_PASSWORD=
SNOWFLAKE_ANALYST_PASSWORD=


# =============================================================================
# [STEP 3]  DEFAULTS  — already correct. Only change if you renamed something.
# =============================================================================

# --- Snowflake user/role names (created by Terraform with these exact names) -
SNOWFLAKE_LOADER_USER=LOADER
SNOWFLAKE_LOADER_ROLE=LOADER

SNOWFLAKE_DBT_USER=DBT
SNOWFLAKE_DBT_ROLE=DBT

SNOWFLAKE_ANALYST_USER=ANALYST
SNOWFLAKE_ANALYST_ROLE=ANALYST

# --- Snowflake-wide constants (referenced by ingestion + dbt) ----------------
SNOWFLAKE_WAREHOUSE=WH_XS
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_SNAPSHOTS_SCHEMA=SNAPSHOTS
SNOWFLAKE_STAGE=S3_TLC_STAGE

# --- S3 prefix --------------------------------------------------------------
S3_RAW_PREFIX=raw/
